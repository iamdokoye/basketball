# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# Local Supabase: run `supabase start`, then `supabase status -o env` for the values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- Who can edit ---------------------------------------------------------
# Anyone can view. Anyone can score during the window below; everything else
# (and any edit outside the window) needs the admin password.
LEAGUE_TIMEZONE=Africa/Lagos
# Day and 24-hour start-end in LEAGUE_TIMEZONE. Default: Sat 06:00-13:00
# LEAGUE_WINDOW=Sat 06:00-13:00
# Optional: keep scoring open this many minutes after the window ends (default 0).
# LEAGUE_WINDOW_GRACE_MIN=0
# Choose a long, unique password. Changing it signs every admin out.
ADMIN_PASSWORD=

# --- Seasons -----------------------------------------------------------------
# How long a season is: year (default), half (Jan-Jun / Jul-Dec) or quarter.
# LEAGUE_SEASON=year

# --- Title cards ---------------------------------------------------------------
# The hour (0-23, league time) the day's cards are revealed on a game day. Default 14 (2 PM).
# LEAGUE_CARDS_HOUR=14
